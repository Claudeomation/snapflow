# Postgres (Neon works as-is)
DATABASE_URL=postgresql://snapflow:snapflow@localhost:5432/snapflow

# Sign-in. Without these the app only runs in demo mode (see README).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Lets the app run without sign-in as the first Owner. Never set in production.
DEMO_MODE=1

# The operator and reply drafting use Claude when this is set.
ANTHROPIC_API_KEY=

# Outgoing email through Resend. Without these, messages are saved to the outbox and not sent.
RESEND_API_KEY=
EMAIL_FROM=

# Public address of the app, used in e-signature links.
APP_URL=http://localhost:3000

# Shared secret for the scheduled job at /api/cron
CRON_SECRET=
